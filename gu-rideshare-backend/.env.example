# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────
# Local:  mongodb://localhost:27017/gu_rideshare
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/gu_rideshare
MONGODB_URI=mongodb://localhost:27017/gu_rideshare

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_in_production_gu2024
JWT_EXPIRE=7d

# ── Email (for OTP) ──────────────────────────────
# Use Gmail with App Password (2FA must be on)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ── Client ───────────────────────────────────────
CLIENT_URL=http://localhost:3000
